#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        // Number-layer digits stay digits even with Shift held
        n1_morph: n1_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp N1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n2_morph: n2_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n3_morph: n3_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp N3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n4_morph: n4_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp N4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n5_morph: n5_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp N5>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n6_morph: n6_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp N6>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n7_morph: n7_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp N7>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n8_morph: n8_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp N8>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n9_morph: n9_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp N9>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        n0_morph: n0_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp N0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   | 
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ALT  |
            //                    | RSE | CTRL| SPC |   | ENT | LWR  | GUI |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R    &kp T          &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp ESC    &kp A  &kp S  &kp D     &kp F    &kp G          &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHIFT &kp Z  &kp X  &kp C     &kp V    &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp LALT
                         &mo 2     &kp LCTRL &lt 3 SPACE    &mt RSHIFT ENTER  &mo 1  &kp LGUI
            >;
        };

        lower_layer {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1   |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // |      |      |     |     |     |     |   |     |     |     |     |     |      |
            // | SHFT |      |     |     |     |     |   |     |     |     |     |     |  ALT |
            //                     |     | GUI | SPC |   | ENT |PRSCR| ESC |

            bindings = <
&trans  &n1_morph         &n2_morph        &n3_morph           &n4_morph          &n5_morph           &n6_morph         &n7_morph         &n8_morph         &n9_morph         &n0_morph &kp BSPC
&trans  &trans           &trans          &trans             &trans            &trans             &trans           &trans           &trans           &trans           &trans   &trans
&trans  &trans           &trans          &trans             &trans            &trans             &trans           &trans           &trans           &trans           &trans   &kp LALT
                                         &trans             &trans            &trans             &kp INS          &trans           &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |  ~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  _  |  =  |  \  |  [  |  ]  |  ~   |
            // | SHFT | BTCL| BT0 | BT1 |     |     |   |  -  |  +  | "|" |  {  |  }  | ALT  |
            //                    |     | GUI | SPC |   | ENT |     | ESC |

            bindings = <
&trans     &kp EXCL  &kp AT   &kp HASH   &kp DLLR   &kp PRCNT     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans     &trans    &trans   &trans     &trans     &trans        &kp MINUS  &kp PLUS   &kp BSLH   &kp LBKT  &kp RBKT  &kp GRAVE
&trans     &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &trans        &trans              &kp UNDER  &kp EQUAL  &kp PIPE   &kp LBRC  &kp RBRC  &kp LALT
                                       &trans    &trans       &kp SPACE  &kp RET    &trans     &trans
            >;
        };
        layer_3 {
            display-name = "Fn";
            bindings = <
&trans  &kp F1        &kp F2        &kp F3       &kp F4      &kp F5         &kp F6       &kp F7         &kp F8    &kp F9     &kp F10    &kp BSPC
&trans  &out OUT_USB  &out OUT_BLE  &trans       &trans      &kp PG_UP      &kp LEFT     &kp DOWN       &kp UP    &kp RIGHT  &kp F11    &kp DEL
&trans  &sys_reset    &trans        &trans       &trans      &kp PG_DN      &trans       &kp HOME       &kp END   &trans     &kp F12    &kp LALT
                                    &bootloader  &trans      &trans         &trans       &bootloader    &trans
            >;
        };
    };
};